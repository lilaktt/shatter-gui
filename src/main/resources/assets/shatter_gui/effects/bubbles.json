{
  "schema": 2,
  "id": "bubbles",
  "name": "Bubbles",
  "description": "Pieces turn into bubbles that float up, wobble and pop, as in a brewing stand.",
  "open": true,
  "duration": 46,
  "fracture": { "mode": "voronoi", "count": 70, "jitter": 0.5 },
  "trigger": { "type": "wave", "direction": [0, -1], "spread": 0.5, "noise": 0.3 },
  "layers": [
    { "name": "Soak", "module": "stay", "to": 0.15 },
    { "name": "Float up", "module": "gravity", "from": 0.15, "params": { "strength": -0.012, "world": false } },
    { "name": "Water", "module": "drag", "from": 0.15, "params": { "amount": 0.08 } },
    { "name": "Wobble", "module": "drift", "from": 0.15, "params": { "amount": 0.008, "frequency": 0.35 } },
    { "name": "Pop", "module": "scale", "params": { "value": { "keys": [[0, 1], [0.2, 0.85], [0.85, 0.75], [0.92, 1.15], [1, 0]] } } },
    { "name": "Turn", "module": "spin", "params": { "speed": { "random": [-0.08, 0.08] } } }
  ],
  "appearance": {
    "color": [ { "t": 0, "color": "#ffffff" }, { "t": 0.3, "color": "#cfeeff" }, { "t": 1, "color": "#9edcff" } ],
    "alpha": { "keys": [[0, 1], [0.3, 0.9], [0.9, 0.85], [1, 0]] },
    "emissive": { "keys": [[0, 0], [0.4, 0.2], [1, 0.3]] },
    "emissiveColor": "#c6f1ff"
  },
  "emitters": [
    { "name": "Pops", "particle": "minecraft:bubble_pop", "zone": "surface", "rate": 2.5, "from": 0.5, "velocity": [0, 0.01, 0.01] },
    { "name": "Drops", "particle": "minecraft:splash", "zone": "surface", "rate": 1, "from": 0.2, "velocity": [0, 0.01, 0.01] }
  ],
  "sounds": [
    { "name": "Brew", "sound": "minecraft:block.brewing_stand.brew", "volume": 0.5 },
    { "name": "Bubbles", "sound": "minecraft:block.bubble_column.upwards_ambient", "volume": 0.4, "at": 0.2 }
  ]
}