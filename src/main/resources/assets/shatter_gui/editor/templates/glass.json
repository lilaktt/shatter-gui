{
  "schema": 2,
  "id": "glass_fx",
  "name": "Glass",
  "description": "Breaks like a pane of glass: a burst from the centre, then the pieces fall and tumble.",
  "duration": 36,
  "fracture": { "mode": "voronoi", "count": 90, "jitter": 0.6 },
  "trigger": { "type": "radial", "from": "center", "spread": 0.2, "curve": "easeOut" },
  "layers": [
    { "name": "Burst", "module": "launch",
      "params": { "from": "center", "speed": { "random": [0.03, 0.07] }, "spread": 0.5, "out": 0.03 } },
    { "name": "Fall", "module": "gravity", "params": { "strength": 0.025 } },
    { "name": "Tumble", "module": "spin", "params": { "speed": { "random": [-0.25, 0.25] }, "tumble": { "random": [-0.2, 0.2] } } },
    { "name": "Land", "module": "collide", "params": { "bounce": 0.35, "friction": 0.4 } }
  ],
  "appearance": { "alpha": { "keys": [[0, 1], [0.7, 1], [1, 0]] } },
  "emitters": [
    { "name": "Glints", "particle": "minecraft:end_rod", "zone": "front", "rate": 1, "to": 0.4, "velocity": [0, 0, 0.01] }
  ],
  "sounds": [ { "name": "Break", "sound": "minecraft:block.glass.break", "volume": 0.6, "pitch": 1.2 } ]
}
