      "life": { "random": [18, 26] }, "gravity": 0.003, "drag": 0, "size": 0.07,
      "color": ["#e8f2ff", "#9cc4ff"], "alpha": { "keys": [[0, 0], [0.1, 0.9], [0.8, 0.8], [1, 0]] },
      "emissive": false, "max": 300 },
    { "particle": "minecraft:splash", "zone": "surface", "rate": 1.5, "from": 0.2 }
  ],
  "sounds": [
    { "sound": "minecraft:weather.rain", "volume": 0.4, "pitch": 1.2 },
    { "sound": "minecraft:entity.generic.splash", "volume": 0.25, "pitch": 1.4, "at": 0.5 }
  ],
  "modifiers": { "edge": { "direction": "bottom", "exit": true, "exitStart": 0.65, "distance": 0.8 } }
