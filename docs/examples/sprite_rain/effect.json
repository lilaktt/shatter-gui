  "layers": [
    { "module": "launch", "params": { "from": [0.5, -0.5], "speed": { "random": [0.005, 0.02] }, "spread": 0.3, "out": 0.01 } },
    { "module": "gravity", "params": { "strength": 0.012 } },
    { "module": "spin", "params": { "speed": { "random": [-0.08, 0.08] }, "tumble": { "random": [-0.1, 0.1] } } },
    { "module": "drag", "params": { "amount": 0.02 } }
  ],
  "appearance": {
    "color": ["#ffffff", "#cfe6ff"],
    "alpha": { "keys": [[0, 1], [0.7, 0.9], [1, 0]] },
    "overlays": [
      { "texture": "raindrop", "blend": "multiply", "opacity": { "curve": "easeOut", "from": 0, "to": 0.6 },
        "color": "#8fb7ff", "repeat": [6, 3], "scroll": [0, -1.5] }
    ]
