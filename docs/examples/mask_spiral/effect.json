{
  "schema": 2,
  "id": "mask_spiral",
  "name": "Spiral mask",
  "description": "Voronoi pieces come loose along a spiral painted in a mask and swirl into the centre, glowing.",
  "duration": 50,
  "fracture": { "mode": "voronoi", "count": 140, "jitter": 0.9 },
  "trigger": { "type": "mask", "texture": "spiral_mask", "spread": 0.7, "noise": 0.05 },
  "layers": [
    { "module": "spin", "params": { "speed": { "curve": "easeIn", "from": 0.02, "to": 0.4 }, "tumble": { "random": [-0.1, 0.1] } } },
    { "module": "attract", "params": { "to": "center", "strength": { "curve": "easeInCubic", "from": 0.002, "to": 0.03 }, "swirl": 2.5, "absorb": 0.12 } },
    { "module": "drag", "params": { "amount": 0.08 } },
    { "module": "scale", "from": 0.6, "params": { "value": { "curve": "easeIn", "from": 1, "to": 0.2 } } }
  ],
  "appearance": {
    "color": [ { "t": 0, "color": "#ffffff" }, { "t": 0.4, "color": "#8ef6ff" }, { "t": 1, "color": "#b46bff" } ],
    "alpha": { "keys": [[0, 1], [0.8, 0.9], [1, 0]] },
    "emissive": { "keys": [[0, 0], [0.3, 0.5], [1, 0.9]], "ease": "smooth" },
    "emissiveColor": ["#8ef6ff", "#ff9bff"],
    "overlays": [
      { "texture": "energy_lines", "blend": "additive", "opacity": { "curve": "easeOut", "from": 0, "to": 0.8 },
        "color": "#9be8ff", "scroll": [0.6, 0.3], "repeat": [2, 2] }
    ]
  },
  "emitters": [
    { "sprite": "sparkle", "zone": "front", "rate": 3, "velocity": [0, 0.01, 0.01], "spread": 0.01,
      "life": { "random": [10, 20] }, "size": { "curve": "easeOut", "from": 0.08, "to": 0.0 },
      "color": ["#ffffff", "#9be8ff"], "max": 150 }
  ],
  "sounds": [
    { "sound": "minecraft:block.amethyst_block.chime", "volume": 0.6, "pitch": 1.2, "at": "start" },
    { "sound": "minecraft:block.beacon.deactivate", "volume": 0.3, "pitch": 1.6, "at": "end" }
  ]
}